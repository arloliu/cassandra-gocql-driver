#!/usr/bin/env bash
# A fake systemctl for the run-cells.sh fixtures (SYSTEMCTL): FAKE_SYSTEMCTL=show-fail makes every `show` fail,
# FAKE_SYSTEMCTL=jobs-fail makes `list-jobs` fail, stop-fail every `stop`, show-hang and stop-hang make those hang,
# jobs-slow delays `list-jobs` by 3 s, jobs-stop lists a stop job for FAKE_RUNNER_UNIT;
# every other call is the real systemctl.
for a in "$@"; do
  [[ "${FAKE_SYSTEMCTL:-}" == show-fail && "$a" == show ]] && exit 1
  [[ "${FAKE_SYSTEMCTL:-}" == jobs-fail && "$a" == list-jobs ]] && exit 1
  [[ "${FAKE_SYSTEMCTL:-}" == show-hang && "$a" == show ]] && exec sleep 100000
  [[ "${FAKE_SYSTEMCTL:-}" == stop-hang && "$a" == stop ]] && exec sleep 100000
  [[ "${FAKE_SYSTEMCTL:-}" == stop-fail && "$a" == stop ]] && exit 1
  [[ "${FAKE_SYSTEMCTL:-}" == jobs-slow && "$a" == list-jobs ]] && sleep 3
  if [[ "${FAKE_SYSTEMCTL:-}" == jobs-stop && "$a" == list-jobs ]]; then
    echo "4242 ${FAKE_RUNNER_UNIT:-none} stop running"
    exit 0
  fi
done
exec /usr/bin/systemctl "$@"
